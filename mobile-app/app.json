{
  "expo": {
    "name": "Gestion Ordures",
    "slug": "gestion-ordures",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner le QR Code du bac et photographier les dépôts sauvages.",
        "NSLocationWhenInUseUsageDescription": "Valider les collectes et signaler les dépôts par GPS."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.christph.gestionordures"
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-image-picker",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "531c314c-0e8c-495a-8f53-8a34ce32eded"
      }
    }
  }
}
